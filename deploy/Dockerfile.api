FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY api/api.csproj api/
RUN dotnet restore api/api.csproj

COPY api/ api/
RUN dotnet publish api/api.csproj \
    --configuration Release \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir backtrader pandas pyarrow

ENV ASPNETCORE_URLS=http://+:8080 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

COPY --from=build /app/publish/ ./

WORKDIR /workspace
COPY execute ./execute
COPY pipeline ./pipeline
COPY Backtests ./Backtests
COPY api/Backtest_runs ./api/Backtest_runs

RUN mkdir -p /workspace/pipeline/data/backtest_data /workspace/api/Backtest_runs

WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["dotnet", "api.dll"]
